% !TeX root = main.tex
\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesPackage{yibinthesis-literature-review}
  [2026/10/09 v0.2 Yibin University literature-review module]

\makeatletter

% Give TeX a final line-breaking pass for long technical terms and citations.
\setlength{\emergencystretch}{2em}

% The review is a flowing article: numbered chapters do not start new pages.
% These overrides are loaded only by the literature-review class option.
\titleclass{\chapter}{straight}
\titleformat{\chapter}[block]
  {\yibinhei\bfseries\zihao{3}}
  {\thechapter}{0.5em}{}
\ifyibin@science
  \titlespacing{\chapter}{0pt}{18pt}{12pt}
  \titlespacing{\section}{0pt}{18pt}{12pt}
  \titlespacing{\subsection}{0pt}{15pt}{9pt}
  \titlespacing{\subsubsection}{0pt}{12pt}{6pt}
\else
  \titlespacing{\chapter}{2em}{18pt}{12pt}
  \titlespacing{\section}{2em}{18pt}{12pt}
  \titlespacing{\subsection}{2em}{15pt}{9pt}
  \titlespacing{\subsubsection}{2em}{12pt}{6pt}
\fi
\titleformat{name=\chapter,numberless}[block]
  {\centering\yibinhei\bfseries\zihao{3}}
  {}{0pt}{}
\titlespacing{name=\chapter,numberless}{0pt}{18pt}{12pt}

% Both review templates show continuous figure and table numbers.
\counterwithout{figure}{chapter}
\counterwithout{table}{chapter}

% setspace reapplies the current size.  Select the required five-size text
% after the stretch factor so bibliography entries remain 10.5 pt.
\ifyibin@bibliography
  \AtBeginBibliography{\setstretch{1.5}\yibinsong\zihao{5}}
\fi

% A separate value paragraph allows a long title to wrap at the template's
% 16 pt size while keeping the 18 pt label and the following fields intact.
\newcommand{\yibin@reviewcovertitle}{%
  \noindent\yibin@coverlabel{3.7cm}{题\hspace{2em}目}%
  \parbox[t]{11.8cm}{%
    \setstretch{1}\yibinsong\bfseries\fontsize{16bp}{32bp}\selectfont%
    \centering\CJKunderline{\strut\yibintitle\hfill\strut}\par}%
}

