    \null
  \endgroup
  \frontmatter
  \pagenumbering{arabic}
}

\ExplSyntaxOn
\NewDocumentCommand{\yibin@reviewaffiliation}{}{
  \seq_clear:N \l_tmpa_seq
  \clist_map_inline:nn {
    g_yibin_college_tl,
    g_yibin_affiliation_city_tl,
    g_yibin_affiliation_postcode_tl
  } {
    \tl_if_empty:cF {##1} {\seq_put_right:Nv \l_tmpa_seq {##1}}
  }
  \seq_if_empty:NF \l_tmpa_seq {（\seq_use:Nn \l_tmpa_seq {\quad}）}
}
\ExplSyntaxOff

\newcommand{\yibin@reviewabstractheading}[2]{%
  \par\vspace{9pt}%
  {\setstretch{1}\centering #1\bfseries\zihao{3}#2\par}%
  \nobreak\vspace{6pt}%
}

% Collect the Chinese source until the English source arrives.  One unbroken
% block keeps the title, author, affiliation, abstracts and keywords together
% without changing the author's cnabstract/enabstract input convention.
\long\def\yibin@reviewcnabstract{}
\RenewDocumentEnvironment{cnabstract}{+b}{%
  \long\gdef\yibin@reviewcnabstract{#1}%
}{}

% The review template numbers the abstract as page 1 and continues with page 2
% for the body.  Only the header style changes at this boundary.
\newcommand{\yibin@reviewbodymatter}{%
  \clearpage
  \@mainmattertrue
  \pagestyle{yibinmain}
  \yibin@plainmain
}

\RenewDocumentEnvironment{enabstract}{+b}{%
  \noindent\begin{minipage}[t]{\textwidth}
    \setstretch{1.5}%
    {\setstretch{1}\centering\yibinhei\bfseries\zihao{3}\yibintitle\par}%
    {\centering\yibinhei\zihao{-4}\yibinauthor\par}%
    {\centering\yibinhei\zihao{-4}\yibin@reviewaffiliation\par}%
    \yibin@reviewabstractheading{\yibinhei}{摘要}%
    {\yibinsong\zihao{-4}\setlength{\parindent}{2em}%
      \yibin@reviewcnabstract\par}%
    \yibin@reviewabstractheading{\yibinenglishfont}{Abstract}%
    {\yibinenglishfont\zihao{-4}\setlength{\parindent}{0pt}%
      #1\par}%
  \end{minipage}\par
}{%
  % Run outside the environment group so the body page style remains active.
  \aftergroup\yibin@reviewbodymatter
}

\RenewDocumentCommand{\cnkeywords}{m}{%
  \par\vspace{6pt}%
  \noindent{\yibinhei\bfseries 关键词：}{\yibinsong #1}\par
}
\RenewDocumentCommand{\enkeywords}{m}{%
  \par\vspace{6pt}%
  \noindent{\yibinenglishfont\bfseries Keywords: }{\yibinenglishfont #1}\par
}

\makeatother
\endinput
