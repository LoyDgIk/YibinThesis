    \end{textblock*}
    \begin{textblock*}{15.5cm}(3cm,24.0cm)
      \centering\yibinsong\bfseries\zihao{-3}%
      \yibinifdate{\yibindate}{%
        \underline{\makebox[1.5cm]{\strut}}年\quad
        \underline{\makebox[1cm]{\strut}}月\quad
        \underline{\makebox[1cm]{\strut}}日}%
