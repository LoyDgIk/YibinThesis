      \yibin@coverdualfield{指导教师1}{3.7cm}{5.3cm}{\yibinadvisor}%
        {\hspace{0.3cm}职称}{1.9cm}{4.6cm}{\yibinadvisortitle}
    \end{textblock*}
    \begin{textblock*}{15.5cm}(3cm,20.4cm)
      \yibin@coverdualfield{指导教师2}{3.7cm}{5.3cm}{\yibinsecondadvisor}%
