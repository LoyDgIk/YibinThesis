\newcommand{\yibin@proposalbody}[1]{%
  \begingroup
    % The supplied opening-report form uses single-spaced 12 pt text inside
    % cells; the thesis/review body uses 1.5 spacing separately.
    \yibinsong\zihao{-4}\setstretch{1.0}%
    \setlength{\parindent}{2em}%
    \setlength{\parskip}{0pt}%
    #1\par
  \endgroup
}

\newsavebox{\yibin@proposalcovervaluebox}

\newcommand{\yibin@proposalcoverlabel}[2]{%
  \makebox[#1][l]{\yibinsong\bfseries\fontsize{14bp}{18bp}\selectfont #2}%
}

\newcommand{\yibin@proposalcovervalue}[2]{%
  \begingroup
    \yibinsong\fontsize{14bp}{18bp}\selectfont
    \sbox{\yibin@proposalcovervaluebox}{\strut #2\strut}%
    \underline{\makebox[#1][c]{%
      \ifdim\wd\yibin@proposalcovervaluebox>#1
        \resizebox{\dimexpr#1-0.2cm\relax}{!}{\usebox{\yibin@proposalcovervaluebox}}%
      \else
        \usebox{\yibin@proposalcovervaluebox}%
      \fi}}%
  \endgroup
}

\newcommand{\yibin@proposalcoverlongvalue}[2]{%
  \begin{minipage}[t]{#1}%
    \yibinsong\fontsize{14bp}{24bp}\selectfont\raggedright
    \yibinProposalCoverTitleLinesExpand{#2}%
  \end{minipage}%
}

\ExplSyntaxOn
\seq_new:N \l_yibin_proposal_title_lines_seq
\tl_new:N \l_yibin_proposal_title_line_tl
\dim_new:N \l_yibin_proposal_title_line_dim
\dim_new:N \l_yibin_proposal_title_char_dim
\box_new:N \l_yibin_proposal_title_char_box

\cs_new_protected:Npn \yibinProposalCoverTitleLines #1
  {
    \seq_clear:N \l_yibin_proposal_title_lines_seq
    \tl_clear:N \l_yibin_proposal_title_line_tl
    \dim_zero:N \l_yibin_proposal_title_line_dim
    \tl_map_inline:nn {#1}
      {
        \hbox_set:Nn \l_yibin_proposal_title_char_box {##1}
        \dim_set:Nn \l_yibin_proposal_title_char_dim
          {\box_wd:N \l_yibin_proposal_title_char_box}
        \dim_compare:nNnT
          {\l_yibin_proposal_title_line_dim + \l_yibin_proposal_title_char_dim}
          > {\linewidth}
          {
            \tl_if_empty:NF \l_yibin_proposal_title_line_tl
              {
                \seq_put_right:NV \l_yibin_proposal_title_lines_seq
                  \l_yibin_proposal_title_line_tl
                \tl_clear:N \l_yibin_proposal_title_line_tl
                \dim_zero:N \l_yibin_proposal_title_line_dim
              }
          }
        \tl_put_right:Nn \l_yibin_proposal_title_line_tl {##1}
        \dim_add:Nn \l_yibin_proposal_title_line_dim
          {\l_yibin_proposal_title_char_dim}
      }
    \tl_if_empty:NF \l_yibin_proposal_title_line_tl
      {\seq_put_right:NV \l_yibin_proposal_title_lines_seq
        \l_yibin_proposal_title_line_tl}
    \seq_map_inline:Nn \l_yibin_proposal_title_lines_seq
      {
        \noindent\hbox_to_wd:nn {\linewidth} {\strut ##1\hfil}\par
        \vskip 1pt
        \hrule height 0.45pt
        \vskip 2pt
      }
  }
\cs_new_protected:Npn \yibinProposalCoverTitleLinesExpand #1
  {\exp_args:Ne \yibinProposalCoverTitleLines {#1}}
\ExplSyntaxOff

\newcommand{\yibin@proposalcoverfield}[4]{%
  \noindent\yibin@proposalcoverlabel{#2}{#1}%
  \yibin@proposalcovervalue{#3}{#4}%
}

\newcommand{\yibin@proposalcoverlongfield}[4]{%
  \noindent\yibin@proposalcoverlabel{#2}{#1}%
  \yibin@proposalcoverlongvalue{#3}{#4}%
}

\newcommand{\yibin@proposalcoverdualfield}[8]{%
  \noindent
  \yibin@proposalcoverlabel{#2}{#1}%
  \yibin@proposalcovervalue{#3}{#4}%
  \yibin@proposalcoverlabel{#6}{#5}%
  \yibin@proposalcovervalue{#7}{#8}%
}

\newcommand{\yibin@proposal@field@significance}[1]{%
  \begin{yibin@proposalbox}{\shortstack{选\\题\\意\\义}}{165.15pt}{}
    \yibin@proposalbody{#1}
  \end{yibin@proposalbox}
}

\expandafter\newcommand\csname yibin@proposal@field@research-status\endcsname[1]{%
  \begin{yibin@proposalbox}{\shortstack{国\\内\\外\\研\\究\\现\\状\\概\\述}}{297.15pt}{}
    \yibin@proposalbody{#1}
  \end{yibin@proposalbox}
}

\expandafter\newcommand\csname yibin@proposal@field@research-content\endcsname[1]{%
  \begin{yibin@proposalbox}{\shortstack{主\\要\\研\\究\\内\\容}}{183.15pt}{}
    \yibin@proposalbody{#1}
  \end{yibin@proposalbox}
}

\expandafter\newcommand\csname yibin@proposal@field@research-approach\endcsname[1]{%
  % This long narrative can span pages; natural height avoids a blank tail at a page break.
  \begin{yibin@proposalboxnatural}{\shortstack{拟\\采\\用\\的\\研\\究\\思\\路}}{}
    \yibin@proposalbody{#1}
  \end{yibin@proposalboxnatural}
}

\newcommand{\yibin@proposal@field@schedule}[1]{%
  \begin{yibin@proposalbox}{\shortstack{研\\究\\工\\作\\安\\排\\及\\进\\度}}{140.1pt}{}
    \yibin@proposalbody{#1}
  \end{yibin@proposalbox}
}

\newcommand{\yibin@proposal@field@references}[1]{%
  \begin{yibin@proposalbox}{\shortstack{参\\考\\文\\献\\目\\录}}{383.6pt}{}
    \yibin@proposalbody{#1}
  \end{yibin@proposalbox}
}

\expandafter\newcommand\csname yibin@proposal@field@advisor-opinion\endcsname[1]{%
  \begin{yibin@proposalbox}{\shortstack{指\\导\\教\\师\\意\\见}}{99.9pt}{}
    \yibin@proposalbody{#1}
    \par\vspace{0.6\baselineskip}
    \noindent\hfill
    \yibinsong\zihao{-4}签名：\yibin@signatureimage{\yibinadvisorsignature}{2.35cm}%
    \hspace{2em}\yibinifadvisorsignaturedate
      {\yibinadvisorsignaturedate}{年\hspace{1.4em}月\hspace{1.4em}日}
  \end{yibin@proposalbox}
}

