\RequirePackage[most]{tcolorbox}

\makeatletter

% A form field has no chapter: section is its first outline level.  The
% public section commands keep the same meaning in both discipline profiles.
\ifyibin@science
  \renewcommand{\thesection}{\arabic{section}}
  \renewcommand{\thesubsection}{\thesection.\arabic{subsection}}
  \renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}
  \newcommand{\yibin@proposalheadingindent}{0pt}
\else
  \renewcommand{\thesection}{\chinese{section}、}
  \renewcommand{\thesubsection}{（\chinese{subsection}）}
  \renewcommand{\thesubsubsection}{\arabic{subsubsection}.}
  \renewcommand{\theparagraph}{（\arabic{paragraph}）}
  \newcommand{\yibin@proposalheadingindent}{2em}
\fi
\setcounter{secnumdepth}{4}

% Block headings remain inside the breakable cell; none starts a new page.
\titleformat{\section}[block]
  {\yibinhei\bfseries\zihao{3}}
  {\thesection}{0.5em}{}
\titleformat{\subsection}[block]
  {\yibinkai\bfseries\zihao{-3}}
  {\thesubsection}{0.5em}{}
\titleformat{\subsubsection}[block]
  {\yibinsong\bfseries\zihao{4}}
  {\thesubsubsection}{0.5em}{}
\titleformat{\paragraph}[block]
  {\yibinsong\bfseries\zihao{4}}
  {\theparagraph}{0.5em}{}
\titlespacing{\section}{\yibin@proposalheadingindent}{18pt}{12pt}
\titlespacing{\subsection}{\yibin@proposalheadingindent}{18pt}{12pt}
\titlespacing{\subsubsection}{\yibin@proposalheadingindent}{15pt}{9pt}
\titlespacing{\paragraph}{\yibin@proposalheadingindent}{12pt}{6pt}

\fancypagestyle{yibinproposal}{%
  \fancyhf{}
  \fancyfoot[C]{\yibinenglishfont\zihao{-5}\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

\newcommand{\yibin@proposalrulewidth}{0.75pt}

\newcommand{\yibin@proposaldivider}{%
  \draw[line width=\yibin@proposalrulewidth]
    ([xshift=43pt]frame.north west) -- ([xshift=43pt]frame.south west);%
}

\newcommand{\yibin@proposalframe}{%
  \draw[line width=\yibin@proposalrulewidth]
    (frame.north west) rectangle (frame.south east);%
}

\newcommand{\yibin@proposallabelnode}[1]{%
  \node[anchor=center,text width=28pt,align=center]
    at ([xshift=21.5pt]frame.west)
    {\yibinhei\bfseries\fontsize{12bp}{20bp}\selectfont #1};%
}

